#!/bin/sh

set -e

case "$1" in
    configure)
        # Force overwrite of keyring, since apt-key rewrites it and dpkg sees it as modified
        keyring_file="/usr/share/wazo-keyring/wazo-keyring.gpg"
        cp --preserve=timestamps $keyring_file /etc/apt/trusted.gpg.d/wazo-keyring.gpg
    ;;
    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
